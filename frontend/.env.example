# Copy to .env.local for development

# Leave empty in development — Vite proxy handles /api/*
VITE_API_BASE_URL=

# Production (set this in Vercel dashboard, not in file):
# VITE_API_BASE_URL=https://navin.onrender.com

# Dev only: where the Vite proxy sends /api (default http://localhost:8000).
# Use your laptop's LAN IP when testing from a phone: VITE_PROXY_TARGET=http://192.168.x.x:8000

# Optional: override structure ID for testing
# VITE_DEMO_STRUCTURE_ID=struct_demo_001
